        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="mss-foot__bottom">
    <span>出品　費陀有限公司 Fetod Ltd.｜統一編號 00160662｜<a href="mailto:hello@mountsunmoon.com">hello@mountsunmoon.com</a></span>
    <span>&copy; {{ 'now' | date: '%Y' }} 日月山 Mount Sun Moon</span>
  </div>
</footer>
{%- endif -%}

{%- if shop.published_locales.size > 1 -%}
  {%- assign zh_path = request.path -%}
  {%- if request.locale.iso_code == 'en' -%}
    {%- assign zh_path = request.path | remove_first: '/en' -%}
    {%- if zh_path == '' -%}{%- assign zh_path = '/' -%}{%- endif -%}
    {%- capture lang_href -%}{{ zh_path }}{%- endcapture -%}
    {%- assign lang_label = '中文' -%}
    {%- assign lang_title = '切換到中文' -%}
  {%- else -%}
    {%- capture lang_href -%}/en{% if request.path != '/' %}{{ request.path }}{% endif %}{%- endcapture -%}
    {%- assign lang_label = 'EN' -%}
    {%- assign lang_title = 'Switch to English' -%}
  {%- endif -%}
  <script>
    (function () {
      function addLang() {
        if (document.querySelector('.mss-lang')) return;
        var acct = document.querySelector('header-actions .account-button') || document.querySelector('header-actions .header-actions__action');
        var a = document.createElement('a');
        a.className = 'mss-lang'; a.href = {{ lang_href | json }}; a.textContent = {{ lang_label | json }};
        a.title = {{ lang_title | json }}; a.setAttribute('aria-label', {{ lang_title | json }}); a.setAttribute('hreflang', {{ lang_label | json }} === 'EN' ? 'en' : 'zh-TW');
        if (acct && acct.parentNode) { acct.parentNode.insertBefore(a, acct); }
        else if (document.querySelector('header-actions')) { document.querySelector('header-actions').prepend(a); }
        else { a.style.cssText = 'position:fixed;top:12px;right:120px;z-index:50;background:#fbf8f2'; document.body.appendChild(a); }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', addLang); else addLang();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "日月山頁尾",
  "settings": []
}
{% endschema %}
