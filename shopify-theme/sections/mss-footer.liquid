{% render 'mss-styles' %}
{%- if request.locale.iso_code == 'en' -%}
<footer class="mss-foot" lang="en">
  <div class="mss-foot__in">
    <div class="mss-foot__brand">
      <div class="mss-foot__logo">Mount Sun Moon</div>
