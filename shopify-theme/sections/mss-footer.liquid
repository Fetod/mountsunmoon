      <p>Five roasters, five fires, one box. A good cup of coffee brings more light to life.</p>
      <p>Our proceeds support the education programmes of LIA Lumière International Academy.</p>
    </div>
    <div>
      <h4>Shop</h4>
      <ul>
        <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
        <li><a href="{{ routes.root_url }}#gifting">Corporate & custom gifts</a></li>
        <li><a href="{{ routes.root_url }}#faq">Ordering & FAQ</a></li>
        <li><a href="{{ routes.search_url }}">Search</a></li>
      </ul>
    </div>
    <div>
      <h4>Contact</h4>
      <ul>
        <li><a href="https://lin.ee/qiXpWYM" target="_blank" rel="noopener">LINE official account</a></li>
        <li><a href="mailto:hello@mountsunmoon.com">hello@mountsunmoon.com</a></li>
        <li><a href="https://mountsunmoon.com/en/" target="_blank" rel="noopener">Mount Sun Moon brand site</a></li>
