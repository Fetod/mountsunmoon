<article class="mss-artisan">
  <p class="mss-artisan__no">{{ no }}</p>
  <h3 class="mss-h3">{{ name }}</h3>
  <p class="mss-meta">{{ role }}</p>
  <p class="mss-artisan__bio">{{ bio }}</p>
  <dl class="mss-artisan__spec">
    <div><dt>推薦豆款</dt><dd>{{ bean }}</dd></div>
    <div><dt>烘焙度</dt><dd>{{ roast }}</dd></div>
    <div><dt>風味筆記</dt><dd>{{ notes }}</dd></div>
  </dl>
  <p class="mss-artisan__quote">「{{ quote }}」</p>
</article>
