{%- comment -%} 日月山共用樣式：明亮自然光 {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&display=swap');
  .mss, .mss-foot, .mss-px {
    --mss-bg: #fbf8f2; --mss-paper: #f3ede2; --mss-ink: #2e2b26; --mss-muted: #6f695e;
    --mss-line: #e4dccd; --mss-navy: #17496b; --mss-navy-d: #103650; --mss-gold: #b48537;
    --mss-serif: 'Noto Serif TC', 'Songti TC', 'PMingLiU', serif;
    --mss-sans: -apple-system, 'PingFang TC', 'Noto Sans TC', 'Microsoft JhengHei', sans-serif;
    color: var(--mss-ink); font-family: var(--mss-sans); line-height: 1.85; letter-spacing: .02em;
  }
  .mss { background: var(--mss-bg); }
  .mss *, .mss-foot *, .mss-px * { box-sizing: border-box; }
  .mss p, .mss-px p { margin: 0 0 1em; }
  .mss a, .mss-px a { color: var(--mss-navy); }
  .mss-eyebrow { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--mss-gold); margin: 0 0 .8em !important; font-weight: 600; }
  .mss-h1, .mss-h2, .mss-h3, .mss-h4, .mss-quote { font-family: var(--mss-serif); font-weight: 600; color: var(--mss-ink); letter-spacing: .06em; margin: 0 0 .6em; }
  .mss-h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.3; }
  .mss-h2 { font-size: clamp(24px, 3.2vw, 36px); line-height: 1.4; }
  .mss-h3 { font-size: 20px; line-height: 1.5; }
  .mss-h3 a { color: inherit; text-decoration: none; }
  .mss-h4 { font-size: 17px; }
  .mss-lead { font-size: clamp(15px, 1.6vw, 18px); color: var(--mss-muted); }
  .mss-sub { color: var(--mss-muted); max-width: 640px; margin-left: auto !important; margin-right: auto !important; }
  .mss-meta { font-size: 13px; color: var(--mss-muted); margin-bottom: .6em !important; }
  .mss-note { font-size: 14px; color: var(--mss-muted); text-align: center; margin-top: 1em !important; }
  .mss-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .mss-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px; background: var(--mss-navy); color: #fff !important; border: 1px solid var(--mss-navy); border-radius: 999px; font-size: 15px; letter-spacing: .1em; text-decoration: none; cursor: pointer; transition: background .2s; font-family: var(--mss-sans); }
  .mss-btn:hover { background: var(--mss-navy-d); }
  .mss-btn--ghost { background: transparent; color: var(--mss-navy) !important; }
  .mss-btn--ghost:hover { background: var(--mss-navy); color: #fff !important; }
  .mss-btn--full { width: 100%; }
  .mss-btn--disabled { background: var(--mss-line); border-color: var(--mss-line); color: var(--mss-muted) !important; cursor: default; }
  .mss-link { display: block; text-align: center; font-size: 14px; margin-top: 12px; text-decoration: none; }

  .mss-sec { padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 64px); max-width: 1240px; margin: 0 auto; }
  .mss-sec--paper { background: var(--mss-paper); max-width: none; }
  .mss-sec--paper > * { max-width: 1112px; margin-left: auto; margin-right: auto; }
  .mss-head { text-align: center; margin-bottom: clamp(32px, 5vw, 56px); }

  /* hero */
  .mss-hero { position: relative; }
  .mss-hero__media img { display: block; width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; }
  .mss-hero__text { padding: 32px 20px 40px; }
  @media (min-width: 900px) {
    .mss-hero__media img { height: min(86vh, 820px); aspect-ratio: auto; object-position: 60% 50%; }
    .mss-hero__text { position: absolute; top: 50%; transform: translateY(-50%); left: clamp(32px, 6vw, 96px); max-width: 540px; padding: 36px 40px; background: rgba(251,248,242,.82); backdrop-filter: blur(6px); border-radius: 24px; }
  }
  .mss-trust { list-style: none; margin: 0; padding: 22px 20px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; text-align: center; border-bottom: 1px solid var(--mss-line); font-size: 14px; color: var(--mss-muted); }
  .mss-trust strong { display: block; font-family: var(--mss-serif); font-size: 20px; color: var(--mss-ink); }
  @media (min-width: 750px) { .mss-trust { grid-template-columns: repeat(4, 1fr); } }

  /* plans */
  .mss-plans { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 750px) { .mss-plans { grid-template-columns: repeat(3, 1fr); } }
  .mss-plan { background: #fff; border: 1px solid var(--mss-line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
  .mss-plan--feature { border-color: var(--mss-gold); }
  .mss-plan__img { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: var(--mss-paper); }
  .mss-plan__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .mss-plan:hover .mss-plan__img img { transform: scale(1.03); }
  .mss-badge { position: absolute; top: 14px; left: 14px; background: rgba(255,255,255,.92); color: var(--mss-navy); font-size: 12px; letter-spacing: .12em; padding: 4px 12px; border-radius: 999px; }
  .mss-plan__body { padding: 24px; display: flex; flex-direction: column; flex: 1; }
  .mss-plan__limit { font-size: 13px; color: var(--mss-gold); letter-spacing: .1em; margin-bottom: .4em !important; }
  .mss-plan__price { font-family: var(--mss-serif); font-size: 24px; margin-bottom: .2em !important; }
  .mss-plan__cups { font-size: 14px; color: var(--mss-muted); }
  .mss-list { margin: 0 0 16px; padding-left: 1.2em; font-size: 15px; }
  .mss-list li { margin-bottom: .3em; }
  .mss-plan__give { font-size: 13px; color: var(--mss-muted); background: var(--mss-paper); border-radius: 10px; padding: 8px 12px; margin-top: auto !important; }
  .mss-plan__form { margin: 4px 0 0; }
  .mss-plan__anchor { font-size: 14px; color: var(--mss-muted); display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .mss-plan__anchor s { color: #a39c8f; }
  .mss-plan__anchor span { color: var(--mss-navy); font-weight: 600; }
  .mss-wide { display: block; width: 100%; height: auto; aspect-ratio: 3/2; object-fit: cover; border-radius: 20px; margin: 0 auto clamp(28px, 4vw, 48px); max-width: 1112px; }
  @media (min-width: 900px) { .mss-wide { aspect-ratio: 21/9; } }

  /* positioning */
  .mss-split { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .mss-split { grid-template-columns: 1.1fr 1fr; gap: 72px; } }
  .mss-compare { display: grid; gap: 14px; }
  .mss-compare__row { background: var(--mss-bg); border-radius: 14px; padding: 18px 20px; }
  .mss-compare__row span { font-family: var(--mss-serif); font-weight: 600; color: var(--mss-navy); }
  .mss-compare__row p { margin: .3em 0 0 !important; font-size: 15px; color: var(--mss-muted); }

  /* artisans */
  .mss-artisans { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .mss-artisans { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .mss-artisans { grid-template-columns: repeat(3, 1fr); } }
  .mss-artisan { border: 1px solid var(--mss-line); border-radius: 18px; padding: 28px 24px; background: #fff; }
  .mss-artisan__no { font-family: var(--mss-serif); color: var(--mss-gold); font-size: 14px; letter-spacing: .2em; margin-bottom: .4em !important; }
  .mss-artisan__bio { font-size: 15px; }
  .mss-artisan__spec { margin: 0 0 14px; font-size: 14px; }
  .mss-artisan__spec div { display: grid; grid-template-columns: 5em 1fr; padding: 6px 0; border-top: 1px dashed var(--mss-line); }
  .mss-artisan__spec dt { color: var(--mss-muted); }
  .mss-artisan__spec dd { margin: 0; }
  .mss-artisan__quote { font-family: var(--mss-serif); font-size: 15px; color: var(--mss-navy); margin: 0 !important; }

  /* trio */
  .mss-trio { display: grid; gap: 20px; }
  @media (min-width: 750px) { .mss-trio { grid-template-columns: repeat(3, 1fr); } }
  .mss-trio > div { background: var(--mss-bg); border-radius: 18px; padding: 28px; }
  .mss-trio__k { display: inline-flex; width: 44px; height: 44px; border-radius: 50%; align-items: center; justify-content: center; background: var(--mss-navy); color: #fff; font-family: var(--mss-serif); margin-bottom: 14px; }
  .mss-spirit { text-align: center; max-width: 720px !important; margin: clamp(48px, 7vw, 88px) auto; }
  .mss-quote { font-size: clamp(24px, 3.4vw, 38px); }
  .mss-logo-meaning img { width: 100%; max-width: 260px; justify-self: center; background: var(--mss-navy); border-radius: 18px; padding: 32px; }

  /* origins */
  .mss-origins { display: grid; gap: 20px; }
  @media (min-width: 640px) { .mss-origins { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .mss-origins { grid-template-columns: repeat(3, 1fr); } }
  .mss-origins > div { border-top: 2px solid var(--mss-gold); padding-top: 18px; }
  .mss-origins p:last-child { font-size: 15px; }

  /* giving */
  .mss-giving { display: grid; gap: 24px; align-items: center; background: linear-gradient(135deg, #fff7e8, #fbf8f2); border-radius: 24px; margin-top: 24px; margin-bottom: 24px; }
  @media (min-width: 750px) { .mss-giving { grid-template-columns: 220px 1fr; } }
  .mss-giving__num { font-family: var(--mss-serif); font-size: clamp(72px, 10vw, 120px); color: var(--mss-gold); text-align: center; line-height: 1; }

  /* steps */
  .mss-steps { list-style: none; padding: 0; margin: 0 auto; display: grid; gap: 14px; }
  @media (min-width: 900px) { .mss-steps { grid-template-columns: repeat(5, 1fr); } }
  .mss-steps li { background: var(--mss-bg); border-radius: 16px; padding: 22px 18px; font-size: 15px; }
  .mss-steps span { display: block; font-family: var(--mss-serif); font-size: 28px; color: var(--mss-gold); margin-bottom: 6px; }

  /* faq */
  .mss-faq { max-width: 820px; margin: 0 auto; }
  .mss-faq details { border-bottom: 1px solid var(--mss-line); padding: 6px 0; }
  .mss-faq summary { cursor: pointer; list-style: none; padding: 16px 32px 16px 0; font-family: var(--mss-serif); font-size: 17px; position: relative; }
  .mss-faq summary::-webkit-details-marker { display: none; }
  .mss-faq summary::after { content: '+'; position: absolute; right: 4px; top: 12px; font-size: 22px; color: var(--mss-gold); }
  .mss-faq details[open] summary::after { content: '−'; }
  .mss-faq p { color: var(--mss-muted); font-size: 15px; }
  .mss-table { width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 16px; }
  .mss-table th, .mss-table td { text-align: left; padding: 8px 6px; border-top: 1px solid var(--mss-line); vertical-align: top; }
  .mss-table th { width: 8em; color: var(--mss-muted); font-weight: 400; }

  /* cta */
  .mss-cta { display: grid; gap: 20px; }
  @media (min-width: 750px) { .mss-cta { grid-template-columns: 1fr 1fr; } }
  .mss-cta__card { display: flex; gap: 20px; align-items: flex-start; background: #fff; border-radius: 18px; padding: 28px; }
  .mss-cta__card img { flex: none; width: 120px !important; height: 120px !important; max-width: none; border-radius: 8px; }
  @media (max-width: 520px) { .mss-cta__card { flex-direction: column; } }

  /* footer */
  .mss-foot { background: #efe8db; padding: 56px clamp(20px, 5vw, 64px) 28px; font-size: 14px; }
  .mss-foot__in { max-width: 1112px; margin: 0 auto; display: grid; gap: 32px; }
  @media (min-width: 750px) { .mss-foot__in { grid-template-columns: 1.4fr 1fr 1fr; } }
  .mss-foot h4 { font-family: var(--mss-serif); font-size: 15px; margin: 0 0 12px; letter-spacing: .1em; }
  .mss-foot ul { list-style: none; padding: 0; margin: 0; }
  .mss-foot li { margin-bottom: 8px; }
  .mss-foot a { color: var(--mss-ink); text-decoration: none; }
  .mss-foot a:hover { color: var(--mss-navy); text-decoration: underline; }
  .mss-foot__brand p { color: var(--mss-muted); margin: 0 0 .6em; }
  .mss-foot__logo { font-family: var(--mss-serif); font-size: 22px; letter-spacing: .2em; margin-bottom: 8px; }
  .mss-foot__bottom { max-width: 1112px; margin: 36px auto 0; padding-top: 18px; border-top: 1px solid var(--mss-line); color: var(--mss-muted); font-size: 12px; display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }

  /* product extra */
  .mss-px { background: var(--mss-bg); }
  .mss-px__in { max-width: 1112px; margin: 0 auto; padding: 48px clamp(20px, 5vw, 48px); display: grid; gap: 20px; }
  @media (min-width: 750px) { .mss-px__in { grid-template-columns: repeat(3, 1fr); } }
  .mss-px__card { background: #fff; border: 1px solid var(--mss-line); border-radius: 18px; padding: 24px; font-size: 15px; }
  .mss-px__card ul { padding-left: 1.2em; margin: 0; }
</style>
