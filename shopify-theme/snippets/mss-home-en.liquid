      {%- render 'mss-artisan', no: '03', name: 'Kason & Chuck 寶哥', role: 'Founder of Kason Coffee Education Center · 2020 Schweitzer Beverage Master', bean: 'Guatemala Huehuetenango, washed', roast: 'Medium-dark', notes: 'Nuts · Toffee · Gentle sweetness', quote: 'Letting coffee flow like water, nourishing every moment of everyday senses.', bio: 'A coffee practitioner bringing together farm, science, education and daily life, with his own science-based healthy roast curve.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
      {%- render 'mss-artisan', no: '04', name: 'Dahe', role: 'Founder of NINECA STUDIO', bean: 'Honduras “Mountain Mist Awakening”, washed', roast: 'Light-medium', notes: 'Caramel · Honey · Tangerine', quote: 'Through focused fire, gathering the warmth of the sun into a cup that wakes the light within.', bio: 'Roasts in focus and stillness, talking with the green beans with a clear mind; known for clean, pure cups.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
