{%- comment -%} Mount Sun Moon — English homepage. Quick path to buy at the top; story further down, mostly in expandable sections. {%- endcomment -%}
<div class="mss" lang="en">

  <section class="mss-hero">
    <div class="mss-hero__media">
      <img src="{{ img_hero }}&width=1800" alt="A cup of pour-over coffee on a wooden table in soft morning window light" width="1536" height="1024" fetchpriority="high">
    </div>
    <div class="mss-hero__text">
      <p class="mss-eyebrow">Specialty drip-bag coffee from Taiwan</p>
      <h1 class="mss-h1">Five roasters.<br>One box.</h1>
      <p class="mss-lead">Just add hot water. Christmas 2026 limited release.</p>
      <div class="mss-btns mss-hero__btns mss-hero__btns--en">
        <a class="mss-btn" href="#shop">Shop the boxes</a>
        <a class="mss-btn mss-btn--ghost" href="#gifting">Corporate gifts</a>
        <a class="mss-btn mss-btn--ghost" href="#story">Our story</a>
      </div>
    </div>
  </section>

  <ul class="mss-trust">
    <li><strong>5</strong>independent roasters</li>
    <li><strong>10 g</strong>one bag, one cup</li>
    <li><strong>NT$1,000+</strong>free shipping in Taiwan</li>
    <li><strong>5%</strong>to children's arts classes</li>
  </ul>

  <section class="mss-sec" id="shop">
    <div class="mss-head">
      <h2 class="mss-h2">Choose your box</h2>
      <p class="mss-sub">Ships within Taiwan from 1 Dec · pay by 18 Dec for Christmas delivery</p>
    </div>
    <div class="mss-plans">
      {%- for p in (1..3) -%}
        {%- case p -%}
          {%- when 1 -%}{%- assign prod = p5 -%}{%- assign img = img_pour | append: '&width=1100' -%}{%- assign tag = 'Try all five' -%}{%- assign name = 'Discovery Set · 5 bags' -%}{%- assign line = 'One bag from each roaster' -%}{%- assign per = 'NT$53 a cup' -%}
          {%- when 2 -%}{%- assign prod = p10 -%}{%- assign img = p10.featured_image | image_url: width: 1100 -%}{%- assign tag = 'Best for gifting' -%}{%- assign name = 'Gift Set · 10 bags' -%}{%- assign line = 'Two of each, in a cotton pouch' -%}{%- assign per = 'NT$52 a cup' -%}
          {%- when 3 -%}{%- assign prod = pbox -%}{%- assign img = img_gift | append: '&width=1100' -%}{%- assign tag = 'Christmas only · 25 boxes' -%}{%- assign name = 'Collector’s Gift Box' -%}{%- assign line = '10 bags, pour-over kettle, rice crackers' -%}{%- assign per = 'Gift-ready' -%}
        {%- endcase -%}
        {%- if prod != blank -%}
        <article class="mss-plan mss-plan--lean{% if p == 3 %} mss-plan--feature{% endif %}">
          <a href="{{ prod.url }}" class="mss-plan__img">
            <img src="{{ img }}" alt="{{ name | escape }}" loading="lazy" width="1100" height="1100">
            <span class="mss-badge">{{ tag }}</span>
          </a>
          <div class="mss-plan__body">
            <h3 class="mss-h3"><a href="{{ prod.url }}">{{ name }}</a></h3>
            <p class="mss-plan__line">{{ line }}</p>
            <p class="mss-plan__price">{{ prod.price | money_without_currency | remove: '.00' | prepend: 'NT$' }} <span class="mss-plan__per">{{ per }}</span></p>
            {%- if prod.available -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="mss-plan__form">
                <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="mss-btn mss-btn--full">Add to cart</button>
              </form>
            {%- else -%}
              <span class="mss-btn mss-btn--full mss-btn--disabled">Sold out</span>
            {%- endif -%}
            <a href="{{ prod.url }}" class="mss-link">Details</a>
          </div>
        </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="mss-swipe">← Swipe for more →</p>
    <p class="mss-note">5% of every Christmas first-release box goes to children's arts and music classes.</p>
  </section>

  <section class="mss-sec mss-biz" id="gifting">
    <div class="mss-biz__card">
      <div class="mss-biz__text">
        <h2 class="mss-h2">Corporate & custom gifts</h2>
        <p>100+ sets get corporate pricing, with your logo on the box. For year-end parties, Lunar New Year, clients and staff.</p>
        <div class="mss-btns">
          <a class="mss-btn" href="https://lin.ee/qiXpWYM" target="_blank" rel="noopener">Ask on LINE</a>
          <a class="mss-btn mss-btn--ghost" href="mailto:hello@mountsunmoon.com">Email us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mss-sec mss-sec--paper" id="roasters">
    <div class="mss-head">
      <h2 class="mss-h2">The five roasters</h2>
      <p class="mss-sub">The fifth bag is Elias or Fetod, at random.</p>
    </div>
    <div class="mss-roasters">
      <div><b>Emily</b><span>Kenya AA · light</span><em>blackcurrant, sour plum</em></div>
      <div><b>Warren</b><span>House blend · light-medium</span><em>longan honey, cocoa</em></div>
      <div><b>Kason & Chuck</b><span>Guatemala · medium-dark</span><em>nuts, toffee</em></div>
      <div><b>Dahe</b><span>Honduras · light-medium</span><em>caramel, honey</em></div>
      <div><b>Elias <small>or</small> Fetod</b><span>Honduras · Sumatra · medium</span><em>red apple, honey / dark chocolate</em></div>
    </div>
    <details class="mss-more">
      <summary>Meet the roasters</summary>
      <div class="mss-artisans">
        {%- render 'mss-artisan', no: '01', name: 'Emily 蔡詩敏', role: 'Roaster at YOLO’s CAFE · Co-founder of YABOO Coffee', bean: 'Kenya Kirinyaga AA Top, washed', roast: 'Light', notes: 'Blackcurrant · Sour plum · Fruit', quote: 'In a precise fire, carving acidity into its purest, cleanest geometry.', bio: 'Certified barista, roaster and cupper and an international examiner, with more than ten years in Taipei specialty coffee.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
        {%- render 'mss-artisan', no: '02', name: 'Warren 陳啟仁', role: 'Owner of WAZZA Coffee · International certified examiner', bean: '“Taste of Happiness” blend (Mandheling · Huehuetenango · Yirgacheffe · Supremo)', roast: 'Light-medium', notes: 'Longan honey · Almond · Cocoa', quote: 'With warm hand-brewed moments, living life as an unfolding poem.', bio: 'Nearly 20 years in coffee, former Taiwan ambassador for Maxwell House.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
        {%- render 'mss-artisan', no: '03', name: 'Kason & Chuck 寶哥', role: 'Founder of Kason Coffee Education Center', bean: 'Guatemala Huehuetenango, washed', roast: 'Medium-dark', notes: 'Nuts · Toffee · Gentle sweetness', quote: 'Letting coffee flow like water, nourishing every moment of everyday senses.', bio: 'Brings together farm, science, education and daily life, with his own science-based roast curve.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
        {%- render 'mss-artisan', no: '04', name: 'Dahe', role: 'Founder of NINECA STUDIO', bean: 'Honduras, washed', roast: 'Light-medium', notes: 'Caramel · Honey · Tangerine', quote: 'Through focused fire, gathering the warmth of the sun into a cup that wakes the light within.', bio: 'Roasts in focus and stillness; known for clean, pure cups.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
        {%- render 'mss-artisan', no: '05', name: 'Elias', role: 'Founder of Lunas Coffee · random pick · limited', bean: 'Honduras La Paz, Finca Iris, orange anaerobic honey', roast: 'Medium', notes: 'Red apple · Honey · Lime · Almond', quote: 'Rooted in the high mountain soil of Honduras.', bio: 'Heir to a family farm in Honduras, farming naturally and shipping his own beans to Taiwan.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
        {%- render 'mss-artisan', no: '05', name: 'Fetod', role: 'Founder of Mount Sun Moon · random pick', bean: 'Indonesia Golden Mandheling G1, natural', roast: 'Medium', notes: 'Caramel · Dark chocolate · Nuts', quote: 'Taking the first fire from my teacher’s hands, and slowly roasting it into my own light.', bio: 'Learned to roast with Kason, starting from a first batch of Golden Mandheling.', lbl_bean: 'Bean', lbl_roast: 'Roast', lbl_notes: 'Notes' -%}
      </div>
    </details>
    <div class="mss-next"><a class="mss-btn" href="#shop">Meet five roasters · Shop</a></div>
  </section>

  <section class="mss-sec" id="brew">
    <div class="mss-head">
      <h2 class="mss-h2">Brew in two minutes</h2>
    </div>
    <ol class="mss-steps mss-steps--3">
      <li><span>1</span>Hang the filter on your cup.</li>
      <li><span>2</span>Bloom with a splash of 90°C water, 20 seconds.</li>
      <li><span>3</span>Pour to 150–180 ml. Lift out and enjoy.</li>
    </ol>
    <div class="mss-next"><a class="mss-btn" href="#shop">Pick a cup, start tomorrow morning!</a></div>
  </section>

  <section class="mss-sec mss-giving" id="glimmer">
    <div class="mss-giving__num">5%</div>
    <div>
      <h2 class="mss-h2">Christmas Glimmer Project</h2>
      <p>5% of every box in this Christmas release goes to arts and music classes at LIA Lumière International Academy in Taiwan. We will publish the total and a record of the classes once this batch has shipped.</p>
      <div class="mss-tally">
        <p class="mss-tally__label">Donated so far</p>
        {%- if donation_total > 0 -%}
          <p class="mss-tally__num">NT${{ donation_total }}</p>
          <p class="mss-tally__meta">From {{ donation_boxes }} paid boxes · as of {{ donation_updated }} · updated weekly</p>
        {%- else -%}
          <p class="mss-tally__meta">Starts with the first paid order · updated weekly</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="mss-sec mss-sec--paper" id="story">
    <div class="mss-head">
      <p class="mss-eyebrow">Our Story</p>
      <h2 class="mss-h2">One box, five crafts</h2>
      <p class="mss-sub">Mount Sun Moon is a curated coffee brand: five roasters each bring their signature bean, and we put them in one box — like a small coffee exhibition you can taste at home.</p>
    </div>
    <details class="mss-more">
      <summary>Read the story behind the name</summary>
      <div class="mss-more__body">
        <p><strong>Heaven, earth and people.</strong> Sun and moon give light; the mountain holds the land where coffee grows; the roasters turn it into flavour — and you, with your cup, are the final brushstroke.</p>
        <p><strong>Still at heart as the mountain.</strong> A mountain stands firm because its roots run deep. Boil the water, wait, let the aroma rise, and sit down steady. Brewing yourself a cup every morning is a small ritual of calm.</p>
        <p><strong>The symbol.</strong> Two peaks rising, a gold sun and a white moon offset into a crescent — what the eye sees is not always the whole picture.</p>
        <p><strong>Why five.</strong> Instead of one brand declaring one standard, five roasters with different lives each interpret the land in their own way. Together the five flavours stand for balance: metal, wood, water, fire and earth.</p>
      </div>
    </details>
    <details class="mss-more">
      <summary>Where the beans come from</summary>
      <img class="mss-wide" src="{{ img_farm }}&width=1600" alt="A highland coffee farm in the morning mist" loading="lazy" width="1536" height="1024">
      <ul class="mss-originlist">
        <li><b>Kenya</b> Kirinyaga, 1,600–1,900 m — bright, berry-like</li>
        <li><b>Indonesia</b> Sumatra Mandheling — full body, cocoa</li>
        <li><b>Guatemala</b> Huehuetenango, 1,500–2,000 m — clean and sweet</li>
        <li><b>Ethiopia</b> Yirgacheffe, 1,700–2,200 m — floral, citrus</li>
        <li><b>Colombia</b> Supremo, Andes — balanced, round</li>
        <li><b>Honduras</b> 1,400–1,550 m — honey and experimental processing</li>
      </ul>
    </details>
  </section>

  <section class="mss-sec" id="faq">
    <div class="mss-head">
      <h2 class="mss-h2">FAQ</h2>
    </div>
    <div class="mss-faq">
      <details><summary>Do you ship outside Taiwan?</summary><p>Online orders ship within Taiwan. For overseas orders, email hello@mountsunmoon.com.</p></details>
      <details><summary>Shipping time and cost</summary><p>From 1 December, in order. Paid by 18 December should arrive before Christmas. Free over NT$1,000, otherwise NT$85.</p></details>
      <details><summary>How do I pay?</summary><p>Bank transfer for now — details appear after checkout. Please pay within 3 days and report it on the <a href="{{ routes.root_url | append: '/pages/remit' | replace: '//', '/' }}">payment report page</a>. Card payment coming soon.</p></details>
      <details><summary>How long does the coffee keep?</summary><p>12 months unopened, cool and dry.</p></details>
    </div>
  </section>

  <section class="mss-sec mss-sec--paper">
    <div class="mss-cta">
      <div class="mss-cta__card">
        <img src="https://mountsunmoon.com/assets/line-qr.png" alt="Mount Sun Moon LINE official account QR code" width="120" height="120" loading="lazy">
        <div>
          <h3 class="mss-h3">Questions?</h3>
          <p>Message us on LINE or email hello@mountsunmoon.com — English or Chinese.</p>
          <a class="mss-btn" href="https://lin.ee/qiXpWYM" target="_blank" rel="noopener">Add on LINE</a>
        </div>
      </div>
    </div>
  </section>

</div>
